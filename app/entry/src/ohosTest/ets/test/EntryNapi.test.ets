import entry from 'libentry.so';
import { describe, it, expect } from '@ohos/hypium';

const SAMPLE_HEX =
  '0881808080808080101205616c6963651a01611a016222050a015810032a036540783807' +
  '42060a026b31100142060a026b321002';

// @sample user_batch_c20_plus_empty (56 B; generated by scripts/check_batch_sample.py)
const BATCH_HEX =
  '0a340881808080808080101205616c6963651a01611a016222050a015810032a03654078380742060a026b31100142060a026b3210020a00';

function bytesFromHex(hex: string): Uint8Array {
  const out = new Uint8Array(hex.length / 2);
  for (let i = 0; i < out.length; i++) {
    out[i] = parseInt(hex.substring(i * 2, i * 2 + 2), 16);
  }
  return out;
}

function sampleBytes(): Uint8Array {
  return bytesFromHex(SAMPLE_HEX);
}

function batchBytes(): Uint8Array {
  return bytesFromHex(BATCH_HEX);
}


export default function entryNapiTest() {
  describe('EntryNapi', () => {
    it('ping_returns_pong', 0, () => { expect(entry.ping()).assertEqual('pong'); });
    it('add_2_3_returns_5', 0, () => { expect(entry.add(2, 3)).assertEqual(5); });
    // Compile-only in this environment; runs when a device is available.
    it('decodeUser_c20_full', 0, () => {
      const u = entry.decodeUser(sampleBytes());
      expect(u.id).assertEqual('9007199254740993');
      expect(u.name).assertEqual('alice');
      expect(u.profile?.city).assertEqual('X');
      expect(u.scores.k1).assertEqual(1);
    });
    it('decodeMany_c20_plus_empty', 0, () => {
      const batch = entry.decodeMany(batchBytes());
      expect(batch.users.length).assertEqual(2);
      expect(batch.users[0].id).assertEqual('9007199254740993');
      expect(batch.users[1].id).assertEqual('0');
    });
  });
}
