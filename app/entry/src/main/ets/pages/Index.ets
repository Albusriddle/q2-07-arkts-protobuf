import entry from 'libentry.so';

// c20_full.wire (52 bytes): id=2^53+1, name, tags, profile, email, level=7, scores.
const SAMPLE_HEX =
  '0881808080808080101205616c6963651a01611a016222050a015810032a036540783807' +
  '42060a026b31100142060a026b321002';

// @sample user_batch_c20_plus_empty (56 B; generated by scripts/check_batch_sample.py)
const BATCH_HEX =
  '0a340881808080808080101205616c6963651a01611a016222050a015810032a03654078380742060a026b31100142060a026b3210020a00';

@Entry
@Component
struct Index {
  @State pingText: string = 'not called';
  @State sumText: string = 'not called';
  @State decodeText: string = 'not called';
  @State batchText: string = 'not called';

  private bytesFromHex(hex: string): Uint8Array {
    const out = new Uint8Array(hex.length / 2);
    for (let i = 0; i < out.length; i++) {
      out[i] = parseInt(hex.substring(i * 2, i * 2 + 2), 16);
    }
    return out;
  }

  private sampleBytes(): Uint8Array {
    return this.bytesFromHex(SAMPLE_HEX);
  }

  private batchBytes(): Uint8Array {
    return this.bytesFromHex(BATCH_HEX);
  }

  aboutToAppear(): void {
    this.pingText = entry.ping();
    this.sumText = `${entry.add(2, 3)}`;
  }

  build() {
    Column({ space: 16 }) {
      Text('Q2-07 V0.1 NAPI decode slice')
        .fontSize(22)
        .fontWeight(FontWeight.Bold)
      Text(`ping(): ${this.pingText}`)
        .fontSize(16)
      Text(`add(2, 3): ${this.sumText}`)
        .fontSize(16)
      Button('Call ping/add again')
        .onClick(() => {
          this.pingText = entry.ping();
          this.sumText = `${entry.add(2, 3)}`;
        })
      Button('Decode c20_full sample')
        .onClick(() => {
          try {
            const decoded = entry.decodeUser(this.sampleBytes());
            this.decodeText = JSON.stringify(decoded);
          } catch (e) {
            this.decodeText = `decode error: ${e}`;
          }
        })
      Text(`decodeUser: ${this.decodeText}`)
        .fontSize(14)
        .maxLines(12)
      Button('Decode batch sample (2 users)')
        .onClick(() => {
          try {
            const batch = entry.decodeMany(this.batchBytes());
            this.batchText = `${batch.users.length} users; first=${JSON.stringify(batch.users[0])}`;
          } catch (e) {
            this.batchText = `decode error: ${e}`;
          }
        })
      Text(`decodeMany: ${this.batchText}`)
        .fontSize(14)
        .maxLines(12)
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Center)
    .padding(24)
  }
}
